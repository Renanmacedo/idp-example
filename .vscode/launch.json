  "version": "0.2.0",
  "configurations": [
    {
      "name": "Start Backend",
      "type": "node",
      "request": "launch",
      "args": ["package", "start"],
      "cwd": "${workspaceFolder}/packages/backend",
      "program": "${workspaceFolder}/node_modules/.bin/backstage-cli",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "restart": true,
      "runtimeExecutable": "node",
      "runtimeVersion": "22",
      "env": {
        "NODE_OPTIONS": "--no-node-snapshot"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Frontend",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "runtimeExecutable": "yarn",
      "runtimeArgs": [
        "start"
      ],
      "env": {
        "LOG_LEVEL": "debug"
      },
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "name": "vscode-jest-tests",
      "request": "launch",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npm",
      "args": [
        "test",
        "--",
        "--runInBand",
        "--watchAll=false"
      ]
    }
  ]
}
